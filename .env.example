# Only needed for deploying to the Sepolia testnet from your computer.
# Use a dedicated test wallet, never one that holds real funds.
PRIVATE_KEY=
# Any Sepolia RPC endpoint (Alchemy, Infura, ...), or set INFURA_API_KEY instead
SEPOLIA_RPC_URL=
INFURA_API_KEY=

# Optional deploy parameters
INITIAL_SUPPLY=1000000
ENERGY_SOURCE=Solar
# Where marketplace fees go (defaults to the deployer)
TREASURY_ADDRESS=
# ENG sent to the testnet faucet (whole tokens)
FAUCET_FUNDING=100000
